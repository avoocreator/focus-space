# ═══════════════════════════════════════════════════════════════
#  FocusSpace 2.0 — Environment Variables
#  Salin file ini jadi ".env.local" untuk development,
#  lalu isi juga di Vercel → Settings → Environment Variables.
#  Semua yang dibutuhkan di sini 100% GRATIS.
# ═══════════════════════════════════════════════════════════════

# ── SUPABASE (wajib) — database, auth, realtime, storage ──
# 1. Buat akun di https://supabase.com (gratis)
# 2. New Project → pilih region terdekat (Singapore)
# 3. Setelah jadi, buka Project Settings → API
# 4. Jalankan isi file supabase/schema.sql di SQL Editor Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi... (kunci "anon public")

# ── GEMINI (wajib untuk Kuis AI & Kazu) ──
# 1. Buka https://aistudio.google.com/apikey
# 2. Create API key (gratis) → salin di sini
GEMINI_API_KEY=AIza...
# Opsional: model Gemini yang dipakai (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ── SPOTIFY (opsional — untuk integrasi musik Spotify) ──
# 1. Buka https://developer.spotify.com/dashboard → Create app
#    - Redirect URI: http://localhost:3000/music/callback  (untuk dev)
#      dan https://NAMA-APLIKASI.vercel.app/music/callback (untuk produksi)
#    - APIs used: Web API + Web Playback SDK
# 2. Salin Client ID di sini (tidak butuh client secret — pakai PKCE)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=xxxxxxxxxxxxxxxx
